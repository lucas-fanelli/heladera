# Copiá este archivo a .env (o .env.local) y ajustá lo que necesites.
# Todo lo VITE_* se inyecta en el cliente: NO pongas secretos acá.

# Backend: 'fake' (nivel A, en memoria) | 'firestore' (nivel B: src/db/firestore.ts, necesita las VITE_FIREBASE_* de abajo)
VITE_DB=fake

# Router: 'path' (/l/<id>, requiere rewrites SPA) | 'hash' (#/l/<id>, sirve desde cualquier lado)
VITE_ROUTER=path

# Escala de las animaciones de Motion (1 normal, 0 instantáneo; útil en tests/E2E)
VITE_MOTION_SCALE=1

# Escala de los tiempos de dominio (espera antes de mover una fila, toasts, etc.)
VITE_TIMING_SCALE=1

# --- Nivel B: Firebase (Firestore + Auth anónima) ---
# Con VITE_DB=firestore la app habla con un proyecto de Firebase de verdad y hacen falta estas cuatro.
# Salen de Firebase Console › Configuración del proyecto › Tus apps › app Web › firebaseConfig (ver README, "Nivel B").
# Son públicas por diseño (viajan en el bundle): la seguridad la ponen firestore.rules, no estas claves.
# El AUTH_DOMAIN va al dominio de hosting propio (no <proyecto>.firebaseapp.com): la redirección de la cuenta
# (D23, "guardar tu acceso con Google") tiene que ser same-origin en la app publicada.
# VITE_DB=firestore
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=<proyecto>.web.app
# VITE_FIREBASE_PROJECT_ID=<proyecto>
# VITE_FIREBASE_APP_ID=
# 'true' → el SDK apunta a los emuladores locales (Firestore 127.0.0.1:8080, Auth 127.0.0.1:9099) en vez de la nube.
# Para desarrollar sin proyecto no hace falta tocar nada acá: `npm run emu` en una terminal y `npm run dev:emu`
# (vite --mode emulador) en otra; ese modo carga .env.emulador, que ya trae VITE_DB=firestore, VITE_USE_EMULATORS=true
# y el proyecto ficticio demo-heladera.
# VITE_USE_EMULATORS=

# --- Accesos rápidos (no es VITE_: solo lo lee scripts/qr.mjs) ---
# HELADERA_URL=https://<proyecto>.web.app/h
