{
  "name": "heladera",
  "private": true,
  "version": "0.1.0",
  "description": "La lista de compras de casa, compartida. PWA (React + Motion) con Firestore detrás de una interfaz Db.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:emu": "vite --mode emulador",
    "dev:emu:lan": "vite --mode emulador --host 0.0.0.0 --port 5175 --strictPort",
    "emu": "node scripts/emu.mjs",
    "emu:kill": "node scripts/emu-kill.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --project ui",
    "test:unit": "vitest run --project unit",
    "test:emu": "node scripts/test-emu.mjs",
    "coverage": "vitest run --coverage",
    "verificar": "node scripts/verificar-release.mjs",
    "deploy": "node scripts/deploy.mjs",
    "qr": "node scripts/qr.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "firebase": "^12.17.1",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "firebase-tools": "^15.27.0",
    "jsdom": "^30.0.1",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
