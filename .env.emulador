# Modo "emulador" (npm run dev:emu = vite --mode emulador): la app real contra los emuladores locales de Firebase.
# Vite lo carga encima de .env; no tiene secretos (los proyectos "demo-*" no existen en la Console) y va commiteado.
# Antes, en otra terminal: `npm run emu` (Firestore en 127.0.0.1:8080, Auth en 127.0.0.1:9099, UI en http://127.0.0.1:4000).

# Db real (src/db/firestore.ts) en vez del falso en memoria
VITE_DB=firestore

# El SDK apunta a los emuladores (connectFirestoreEmulator / connectAuthEmulator en src/db/firebase.ts)
VITE_USE_EMULATORS=true

# Proyecto "demo-*": el emulador lo acepta sin proyecto real ni `firebase login`
VITE_FIREBASE_PROJECT_ID=demo-heladera

# Con emuladores el SDK no valida estas tres: cualquier valor no vacío sirve
VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_APP_ID=demo

# Router por path (/l/<id>): el dev server de Vite ya hace el fallback SPA
VITE_ROUTER=path
